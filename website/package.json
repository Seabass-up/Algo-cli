{
  "name": "algo-cli-web",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.5": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20261006.1": true
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy:cloudflare": "npm run build && wrangler deploy -c dist/server/wrangler.json --domain algo-cli.com --domain www.algo-cli.com",
    "deploy:cloudflare:dry-run": "npm run build && wrangler deploy -c dist/server/wrangler.json --domain algo-cli.com --domain www.algo-cli.com --dry-run",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/dependency-security.test.mjs tests/bounded-glob.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "fast-glob": "file:./vendor/bounded-glob",
    "postcss": "8.5.23",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.45",
    "vite": "8.1.6",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "fast-glob": "$fast-glob"
  },
  "type": "module"
}
